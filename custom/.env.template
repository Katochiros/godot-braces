# Paths for build_linux_release.py. Copy to .env (not committed) and edit.
# Relative paths are resolved against this directory; ~ is expanded.

# Godot source tree to build
GODOT_SRC_DIR=/media/penguin/nvmestore2tb/C++ Projects/2026/godot-fork/godot

# export_templates root the editor reads from (a <version>.<status> folder is created inside)
GODOT_TEMPLATES_DIR=/home/penguin/.local/share/godot/export_templates

# Parallel compile jobs; empty = nproc - 2. Set low by default: raise it if you
# want more cores (this machine has 12).
COMPILE_JOBS=2

# Parallel GCC LTO link jobs; empty = 2. Set to 1 by default: 2 fits in RAM only
# when ~9 GB is free. Each uses ~4.3 GB RAM, so keep
# LINK_JOBS x 4.3 GB under free RAM or the build gets OOM-killed.
LINK_JOBS=1

# COMPILE_JOBS / LINK_JOBS environment variables override these.
